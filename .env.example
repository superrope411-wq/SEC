# Required for live SEC access. SEC asks automated clients to identify themselves
# with a name and contact email: https://www.sec.gov/search-filings/edgar-search-assistance/accessing-edgar-data
SEC_USER_AGENT="Your Name your.email@example.com"

# live = download from SEC (cached). fixture = read only local JSON files from EM_FIXTURE_DIR.
EM_MODE=live
# EM_FIXTURE_DIR=./fixtures

# Where the raw cache and SQLite database live.
EM_DATA_DIR=./data

# Conservative request ceiling. SEC's published maximum is 10 requests/second.
EM_MAX_REQUESTS_PER_SECOND=4

# Milestone 2 explanations (optional). Set the key in your shell or a .env file that is never
# committed; the app reads it from the environment and never stores or displays it.
# ANTHROPIC_API_KEY=
# EM_AI_MODEL=claude-opus-5-5
# EM_AI_EFFORT=medium
# EM_AI_MAX_TOKENS=16000
# Total spend allowed across all recorded calls (data/ai_cache.sqlite); calls stop at the cap.
# EM_AI_BUDGET_USD=5.00
